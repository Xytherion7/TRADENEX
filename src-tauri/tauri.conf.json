{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TRADENEX",
  "version": "0.4.0",
  "identifier": "com.tradenex.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TRADENEX — Market Intelligence Terminal",
        "width": 1440,
        "height": 920,
        "minWidth": 1120,
        "minHeight": 740,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://data-api.binance.vision https://api.twelvedata.com wss://stream.binance.com:9443 http://127.0.0.1:1420 ws://127.0.0.1:1420; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Market intelligence and strategy research terminal",
    "longDescription": "TRADENEX is a desktop market research and educational strategy simulation tool.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "displayLanguageSelector": false,
        "languages": [
          "Russian",
          "English"
        ],
        "installMode": "currentUser",
        "startMenuFolder": "TRADENEX",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
